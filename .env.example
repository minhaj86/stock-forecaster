# Copy to .env (never commit .env). Values here are for local development only.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=stockforecast
POSTGRES_USER=stockforecast
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433

# --- Backend (read by Spring Boot; the compose file maps them into the container) ---
# Profiles: local | prod (tests use "test" automatically)
SPRING_PROFILES_ACTIVE=local
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
REDIS_HOST_PORT=6379
# When running the backend outside Docker, point it at the compose database:
DATABASE_URL=jdbc:postgresql://localhost:5433/stockforecast
DATABASE_USERNAME=stockforecast
DATABASE_PASSWORD=change-me-local-only

# Base64 HMAC key, >= 32 bytes decoded. Generate: openssl rand -base64 48
# Required in prod; if empty in the local profile an ephemeral key is generated (sessions end on restart).
JWT_SECRET=
JWT_ISSUER=stock-forecast
JWT_AUDIENCE=stock-forecast-api
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_MAX_LIFETIME=30d
# false only for plain-HTTP local development
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional first administrator, created at startup if both are set (existing accounts are never modified).
# The password is a one-time bootstrap credential: a new one must be chosen at the first sign-in. Set
# ADMIN_REQUIRE_PASSWORD_CHANGE=false only for throw-away local demos. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StockLens-Admin-2026
ADMIN_REQUIRE_PASSWORD_CHANGE=false

# Redis cache (the compose file points the backend at the redis service). CACHE_TYPE=none runs without Redis.
REDIS_HOST=localhost
CACHE_TYPE=redis

# Market data. "synthetic" serves clearly labelled SIMULATED prices for demos; production requires a licensed provider:
# MARKET_DATA_PROVIDER=TWELVE_DATA plus TWELVE_DATA_API_KEY (https://twelvedata.com/account/api-keys).
MARKET_DATA_PROVIDER=synthetic
# TWELVE_DATA_API_KEY=
# API credits per minute of your Twelve Data plan (Basic: 8); every vendor request costs one credit.
# TWELVE_DATA_REQUESTS_PER_MINUTE=8
# Years of daily history loaded when a stock is first tracked.
# MARKET_DATA_INITIAL_HISTORY_YEARS=5

# --- Later phases (not used yet) ---
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
