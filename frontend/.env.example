# Base URL of the Spring Boot API.
# The default "/api/v1" goes through the Vite dev proxy (and nginx in Docker), keeping the app same-origin so the
# HttpOnly refresh cookie works without CORS. To call the API directly instead, use an absolute URL such as
# http://localhost:8080/api/v1 and allow the frontend origin on the backend (CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Target of the dev-server proxy for /api (only used by `npm run dev` / `npm run preview`).
VITE_DEV_PROXY_TARGET=http://localhost:8080
